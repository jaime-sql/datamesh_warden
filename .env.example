# --- Runtime mode ---
# "local"  -> InMemoryStateManager, no GCP calls required
# "cloud"  -> FirestoreStateManager + real BigQuery/Gemini calls
WARDEN_MODE=local

# --- Google Cloud project (required when WARDEN_MODE=cloud) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex AI region for Gemini calls. Independent of Cloud Run/BigQuery.
# Gemini 3.5 Flash is not available in us-central1 — use global (or us).
WARDEN_VERTEX_LOCATION=global

# --- Gemini access ---
# Path A: Google AI Studio API key (simplest, works without gcloud auth)
GEMINI_API_KEY=
# Path B: Vertex AI (uses gcloud Application Default Credentials instead of an API key)
WARDEN_USE_VERTEX=false

# --- Models ---
WARDEN_ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
WARDEN_PATCHER_MODEL=gemini-3.5-flash
WARDEN_GOVERNANCE_MODEL=gemini-3.5-flash

# --- Sub-Agent 1 (Gemma triage) endpoint ---
# URL of the Gemma-on-Cloud-Run service. Leave blank in local mode to use the
# stub/fallback triage implementation.
WARDEN_GEMMA_ENDPOINT=

# --- BigQuery sandbox ---
WARDEN_BQ_SANDBOX_DATASET_PREFIX=warden_sandbox_
WARDEN_BQ_SANDBOX_EXPIRATION_HOURS=24

# --- Orchestrator loop tuning ---
WARDEN_MAX_TURNS=8
WARDEN_TURN_TIMEOUT_S=90
WARDEN_TOOL_TIMEOUT_S=60
WARDEN_INCIDENT_TIMEOUT_S=240

# --- API server ---
WARDEN_API_HOST=0.0.0.0
WARDEN_API_PORT=8080
WARDEN_API_BASE_URL=http://localhost:8080

# --- Logging ---
WARDEN_LOG_LEVEL=INFO
WARDEN_LOG_JSON=false
